# Copy to /etc/lcaitech-assistant.env (root, chmod 600). Never commit real values.
# Comments must be on their own line (systemd EnvironmentFile has no inline comments).

# vertex (ADC / VM service account) | apikey | mock
LLM_PROVIDER=vertex
VERTEX_PROJECT=your-gcp-project
# Gemini 3.x Flash / Flash-Lite GA models are served from "global", "us" or "eu" (not us-central1)
VERTEX_LOCATION=global
MODEL=gemini-3.8-flash
# minimal = lowest level each model supports (3.7/3.8 Flash: LOW)
THINKING_LEVEL=minimal
# thinking tokens count against this limit; the prompt asks for ~90-word answers
MAX_OUTPUT_TOKENS=1024
# Used when the primary fails, is slow (hedging) or times out
FALLBACK_MODEL=gemini-3.1-flash-lite
FALLBACK_LOCATION=global

# Latency (seconds): first token per attempt, start fallback in parallel after, gap between chunks, whole budget
FIRST_TOKEN_TIMEOUT_S=8
HEDGE_AFTER_S=2.5
STREAM_IDLE_TIMEOUT_S=8
TOTAL_BUDGET_S=12
MAX_RETRIES=2
REQUEST_TIMEOUT_S=30
# Explicit Vertex context cache of the system prompt (1 = on)
EXPLICIT_CACHE=1
CACHE_TTL_S=3600
# Instant server-side answers for suggested / frequent questions
FAQ_ENABLED=1
# Only with LLM_PROVIDER=apikey (Gemini API). Add GOOGLE_GENAI_USE_VERTEXAI=true for Vertex AI express mode.
# GOOGLE_API_KEY=

ALLOWED_ORIGINS=https://portfolio.lcaitech.com
ALLOW_LOCALHOST=1
REQUIRE_ORIGIN=1

IP_PER_MINUTE=10
IP_PER_DAY=50
GLOBAL_REQUESTS_PER_DAY=1000
GLOBAL_TOKENS_PER_DAY=8000000
# Hard daily budget in USD, estimated from usage metadata with app/pricing.py (model that answered)
GLOBAL_COST_USD_PER_DAY=1.00

MAX_MSG_CHARS=800
MAX_HISTORY_MESSAGES=10
STATE_DB=/var/lib/lcaitech-assistant/assistant.db
